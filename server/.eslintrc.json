{
  "root": true,
  "env": { "node": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "extends": ["eslint:recommended"],
  "globals": { "fetch": "readonly", "Headers": "readonly", "FormData": "readonly", "Blob": "readonly" },
  "rules": { "no-unused-vars": "warn" }
}
